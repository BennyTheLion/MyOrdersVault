RewriteEngine On

# Domain root -> application
RewriteRule ^$ /public/ [R=302,L]

RewriteBase /public/

# הפניה לקבצים
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L]

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# Anchored on "(^|/)" rather than "^/" so these still match when the app is
# served from a subfolder (e.g. local XAMPP at /my-orders-vault/...) and not
# only when mounted at the domain root.
RedirectMatch 403 (^|/)config/.*$
RedirectMatch 403 (^|/)app/.*$
RedirectMatch 403 (^|/)storage/.*$
RedirectMatch 403 (^|/)vendor/.*$
